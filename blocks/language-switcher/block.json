{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "localizepilot/language-switcher",
  "version": "1.0.2",
  "title": "Language Switcher",
  "category": "widgets",
  "icon": "translation",
  "description": "Display the LocalizePilot language switcher anywhere in your content or templates.",
  "keywords": ["language", "translation", "multilingual"],
  "textdomain": "localizepilot",
  "attributes": {
    "style": {
      "type": "string",
      "default": "inherit"
    },
    "labels": {
      "type": "string",
      "default": "inherit"
    },
    "alignment": {
      "type": "string",
      "default": "inherit"
    }
  },
  "supports": {
    "html": false,
    "customClassName": true,
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "localizepilot-language-switcher-block",
  "editorStyle": "localizepilot-language-switcher-block-editor"
}
